{:paths ["src"]

 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}

 ;; This lib is embedded in every proprietary addon it gates, so its dependency
 ;; surface is part of its contract: malli, plus hive-spi for the ISigner port
 ;; (which brings hive-dsl). All pure Clojure, no crypto library and no native
 ;; code — signing stays on the JDK provider unless a host installs its own
 ;; signer, so a heavier stack is an option and never a dependency.
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        metosin/malli {:mvn/version "0.20.1"}
        io.github.hive-agi/hive-spi {:mvn/version "1.1.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.7"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.35"}
                      ;; TEST ONLY, and deliberately not a :deps entry. gate/gate
                      ;; claims to return what hive-addon's mounter consumes, and
                      ;; the two libraries share no classpath edge, so nothing
                      ;; checked the claim: gate-test asserted it against spec
                      ;; maps this repo wrote itself. journey-test drives the
                      ;; real mounter instead. The shipped dependency surface is
                      ;; unchanged.
                      io.github.hive-agi/hive-addon {:mvn/version "1.0.12"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.19"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}

  :nrepl {:extra-paths ["test"]
          :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                       io.github.hive-agi/hive-test {:mvn/version "0.4.7"}
                       io.github.hive-agi/hive-schemas {:mvn/version "0.1.35"}
                       nrepl/nrepl {:mvn/version "1.7.0"}
                       cider/cider-nrepl {:mvn/version "0.62.2"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"
                      "--port" "7931"]}}}
